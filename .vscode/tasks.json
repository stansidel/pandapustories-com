{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hugo: serve",
      "detail": "Run the site at http://localhost:1313 and reload on changes",
      "type": "shell",
      "command": "hugo server --buildDrafts --disableFastRender",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "hugo",
        "pattern": { "regexp": "^ERROR (.*)$", "message": 1 },
        "background": {
          "activesBegin": true,
          "beginsPattern": "^(Start building sites|Change detected)",
          "endsPattern": "^(Web Server is available|Total in)"
        }
      }
    },
    {
      "label": "Hugo: build",
      "detail": "Build the finished site into public/, as GitHub does",
      "type": "shell",
      "command": "hugo build --gc --minify",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
